{
  "name": "ltn-classroom-layout",
  "version": "1.4.3",
  "description": "Standalone vanilla JS module for an interactive classroom seating chart: desk grid, round/oval tables, rotation/color, student assignment, border objects (wall/board/door/window), wheel zoom, print / PDF export, JSON import/export.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./style.css": "./src/style.css"
  },
  "sideEffects": [
    "src/style.css"
  ],
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm test && npm run lint && npm run format:check"
  },
  "keywords": [
    "classroom",
    "seating-chart",
    "plan-de-classe",
    "education",
    "vanilla-js",
    "no-framework"
  ],
  "author": "Jean-François Rondeau",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rondeaujf/LTN-My-Classroom-Layout.git"
  },
  "homepage": "https://jfrondeau.fr/projects/classroom-layout/",
  "bugs": {
    "url": "https://github.com/rondeaujf/LTN-My-Classroom-Layout/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.5",
    "vitest": "^4.1.10"
  }
}
